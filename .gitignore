node_modules/
.claude/mcp.json
.env
.env.*

# Python bytecode. The tracked .github/scripts/*.py guards write __pycache__/ on
# any local run, and one .pyc had already been committed by accident.
__pycache__/
*.pyc

# Playwright run output. playwright.config.js writes both paths on EVERY run
# (`outputDir` and the json reporter), locally and in CI, and CI uploads them
# from disk — so nothing needs them tracked. A committed copy is only whichever
# sandbox's failed run (S1/S3 fail locally on the agent proxy's CA) got added
# last, and every later run dirties it. Also covers the transient
# `.playwright-artifacts-*` trace scratch dirs a killed run leaves in outputDir.
.agent-reports/screenshots/
.agent-reports/playwright-results.json

# Claude Code agent worktrees (each is a full checkout of this repo)
.claude/worktrees/

# local-only Playwright override (sandbox browser revision)
.github/scripts/ui-tests/pw.local.config.js
